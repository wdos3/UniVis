# Used only by the single semantic step. Images are never sent to OpenAI in Version 2.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PaddleOCR downloads and caches the Korean PP-OCRv5 models on first live use.
PADDLE_PDX_MODEL_SOURCE=BOS
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
PADDLEOCR_CPU_THREADS=8
# Disabled automatically on Windows because Paddle 3.3's oneDNN path can fail there.
PADDLEOCR_ENABLE_MKLDNN=false

# Optional dedicated OCR container. Leave the URL empty to run OCR in the same
# Python process (the default local-development behavior).
PADDLEOCR_SERVICE_URL=
PADDLEOCR_SERVICE_TOKEN=local-dev-ocr-token
PADDLEOCR_SERVICE_TIMEOUT_SECONDS=90
PADDLEOCR_CONTAINER_ENABLE_MKLDNN=false

# Temporary no-key translator. Use libretranslate with a self-hosted instance later.
TRANSLATION_PROVIDER=mymemory
MYMEMORY_URL=https://api.mymemory.translated.net/get
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_SECONDS=20

# Frontend origins allowed to call the local API.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Optional SQLite path. Defaults to ./visnotice.db.
VISNOTICE_DB_PATH=

# INFO, WARNING, or ERROR. Notice text is never written to logs.
LOG_LEVEL=INFO
