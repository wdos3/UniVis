{
  "version": 2,
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py?route=/api/:path*" },
    { "source": "/uploads/:path*", "destination": "/api/index.py?route=/uploads/:path*" },
    { "source": "/demo-images/:path*", "destination": "/api/index.py?route=/demo-images/:path*" }
  ]
}
